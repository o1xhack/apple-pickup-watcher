{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apple 取货监控",
  "version": "0.6.4",
  "identifier": "com.o1xhack.inventory-rush",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apple 取货监控",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "../LICENSE",
      "../NOTICE"
    ]
  },
  "plugins": {}
}
